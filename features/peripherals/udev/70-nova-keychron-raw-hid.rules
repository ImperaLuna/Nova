# Nova's device batteries: lets the logged-in user open Keychron's hidraw
# nodes, so novad can read the battery report that Keychron keyboards on
# the community battery firmware send over raw HID (by themselves through
# their dongle, and when asked on their cable). Keychron Launcher and VIA
# in the browser use the same nodes.
#
# 70-, not 99-: the uaccess tag must be set before 73-seat-late.rules
# turns it into the seat user's ACL.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", TAG+="uaccess"
