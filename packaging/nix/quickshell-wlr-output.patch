 }
 
+// clang-format off
+const wl_output_listener WlrScreencopyContext::OutputTransformQuery::LISTENER = {
+    .geometry = [](void* data, ::wl_output* /*output*/, int32_t /*x*/, int32_t /*y*/, int32_t /*width*/, int32_t /*height*/, int32_t /*subpixel*/, const char* /*make*/, const char* /*model*/, int32_t transform) {
