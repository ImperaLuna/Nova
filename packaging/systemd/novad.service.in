# novad as a systemd user service. novad runs the Quickshell UI as its child
# and restarts it when it crashes; systemd restarts novad.
#
# Placeholders are filled at install time (the Nix package, `nova setup`):
#   @novad@       absolute path of the novad binary
#   @quickshell@  the Quickshell binary novad runs the UI with
#
# niri and Hyprland with uwsm start graphical-session.target, which starts
# this unit. Plain Hyprland doesn't: `exec-once = nova` hands the session's
# environment to systemd and starts it. No Requisite= on the target for
# that reason.
[Unit]
Description=Nova desktop shell (novad and its UI)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@novad@ --quickshell @quickshell@
# novad exits 0 when asked to quit or when the session ends; only crashes
# bring it back.
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
