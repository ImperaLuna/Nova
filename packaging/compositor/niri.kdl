// Nova's niri rules (blur, xembedsniproxy's window, Nova Files' corners),
// written by `nova setup` to ~/.config/nova/niri.kdl (or linked there by the
// home-manager module) and included from niri's config. A flake check runs
// `niri validate` on it.
//
// niri blurs what Quickshell asks for (ext-background-effect), but by default
// a layer surface blurs only the wallpaper ("xray"), which hides the windows
// behind Nova's glass. These settings were tuned with the glass's tint in
// ui/theme/Tokens.qml: more passes melt everything, fewer look sharp.
layer-rule {
    match namespace="^nova-"
    background-effect {
        xray false
    }
}

blur {
    passes 2
    offset 2
    saturation 1.8
}

// xembedsniproxy (Nova's `x11-tray` feature, or the desktop's own) keeps a
// 1x1 X11 window to embed old tray icons in. xwayland-satellite maps it as
// a window niri would tile and focus, and ignores its X11 opacity: float it
// out of the way, unfocused and see-through.
window-rule {
    match app-id="^xembedsniproxy$"
    open-floating true
    open-focused false
    default-column-width { fixed 1; }
    default-window-height { fixed 1; }
    default-floating-position x=0 y=0 relative-to="bottom-right"
    opacity 0.0
}

// Nova Files draws square edges and leaves rounding to the compositor, like
// any app; this is the radius it suggests (packaging/compositor/hyprland.conf
// suggests the same). Your own window-rule for it, after this include, wins.
window-rule {
    match app-id="^nova-files(-picker)?$"
    geometry-corner-radius 16
    clip-to-geometry true
}

// Apps' Open and Save dialogs (Nova Files in picker mode, its own app id)
// float in the middle of the screen at the size Nova Files asks for, like
// any dialog; Nova Files' own windows tile.
window-rule {
    match app-id="^nova-files-picker$"
    open-floating true
}
